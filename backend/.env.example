# Copy to backend/.env for running the API directly (outside Docker).
# Values here are local-development placeholders, not secrets. Never commit backend/.env.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=shelflife
DB_USER=shelflife
DB_PASSWORD=change-me-local-only
# Alternatively set one full URL (takes precedence over DB_*):
# DATABASE_URL=postgresql+psycopg://shelflife:change-me-local-only@localhost:55432/shelflife
EXPIRY_WARNING_DAYS=3
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173
